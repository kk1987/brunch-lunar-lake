+		struct kernfs_node *tmp = kernfs_find_and_get(mm_kobj->sd, "lru_gen");
+
+		if (tmp) {
+			lru_gen_admin_node = kernfs_find_and_get(tmp, "admin");
+			kernfs_put(tmp);
+		}
+	}
 
